# --- Trigger payload (set per conversation by the Foundry trigger) ---
# These come from the frontend session that started the chat.
SURVEY_ID=survey-001
WORKSPACE_ID=12
CATEGORY=Redundancy

# The end-user's JWT bearer token (the same one their browser uses to call
# the Mangrove API). Per-conversation, never stored. Foundry's
# "On Conversation Start" trigger should pass the user's session token here.
USER_TOKEN=

# --- Mangrove API ---
MANGROVE_API_BASE=https://mangrove-api-staging.azurewebsites.net

# --- Azure AI Foundry voice (optional; falls back to LocalVoice if unset) ---
AZURE_AI_PROJECT_ENDPOINT=
FOUNDRY_AGENT_NAME=Decision-Tree-Redundancy
FOUNDRY_AGENT_VERSION=3

LOG_LEVEL=INFO
