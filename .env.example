# Trigger payload (set per conversation by the UI / Foundry trigger)
SURVEY_ID=survey-001
WORKSPACE_ID=12
CATEGORY=Redundancy

# Mangrove API
MANGROVE_API_BASE=https://mangrove-api.azurewebsites.net
# Either provide a static bearer token...
MANGROVE_API_TOKEN=
# ...or let DefaultAzureCredential request a token for this scope:
MANGROVE_API_SCOPE=

# Azure AI Foundry voice (optional; falls back to LocalVoice if unset)
AZURE_AI_PROJECT_ENDPOINT=
FOUNDRY_AGENT_NAME=Decision-Tree-Redundancy
FOUNDRY_AGENT_VERSION=3

LOG_LEVEL=INFO
